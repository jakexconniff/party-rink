{
  "name": "party-rink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-network phone-controlled arcade hockey party game",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./client/** --ignore ./dist/** server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "party": "npm run build && npm start",
    "test": "vitest run",
    "smoke:8": "tsx scripts/smoke-eight.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
